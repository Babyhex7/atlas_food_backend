# ============================================
# KONFIGURASI DATABASE
# ============================================
DB_HOST=mysql
DB_PORT=3306
DB_USER=atlasuser
DB_PASSWORD=atlaspassword
DB_NAME=db_atlas_food
DB_ROOT_PASSWORD=rootpassword

# ============================================
# KONFIGURASI REDIS
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=atlasredis123
REDIS_DB=0

# ============================================
# KONFIGURASI JWT
# WAJIB diubah saat SERVER_MODE=release (minimal 32 karakter)
# ============================================
JWT_SECRET=super-secret-key-atlas-food-2026-vps-production
JWT_EXPIRATION=24h
REFRESH_TOKEN_EXPIRATION=168h

# ============================================
# KONFIGURASI SERVER
# Ubah SERVER_MODE ke 'release' di VPS
# ============================================
SERVER_PORT=8080
SERVER_MODE=release

# ============================================
# KONFIGURASI FRONTEND & CORS (Wajib di VPS)
# FRONTEND_URL: URL publik frontend untuk survey link
# CORS_ALLOWED_ORIGINS: Dipisah koma jika ada domain tambahan
# ============================================
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=

# ============================================
# KONFIGURASI SEED DATA (Wajib diubah di VPS)
# ============================================
ADMIN_SEED_EMAIL=admin@mail.com
ADMIN_SEED_PASSWORD=PasswordKuatAtlas2026!
ADMIN_SEED_NAME=Admin Atlas

# ============================================
# KONFIGURASI UPLOAD FILE
# ============================================
UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE=10485760

# ============================================
# KONFIGURASI GROQ (analisis gizi AI)
# ============================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_TOKENS=2048
