# ============================================
# KONFIGURASI DATABASE
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret
DB_NAME=db_atlas_food

# ============================================
# KONFIGURASI REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=atlasredis123
REDIS_DB=0

# ============================================
# KONFIGURASI JWT
# ============================================
JWT_SECRET=your-super-secret-key-min-32-characters-long
JWT_EXPIRATION=24h
REFRESH_TOKEN_EXPIRATION=168h

# ============================================
# KONFIGURASI SERVER
# ============================================
SERVER_PORT=8080
SERVER_MODE=debug

# ============================================
# KONFIGURASI FRONTEND (untuk generate link survey)
# ============================================
FRONTEND_URL=http://localhost:3000
# Origin tambahan yang boleh mengakses API (CORS + handshake WebSocket).
# Dipisah koma. FRONTEND_URL sudah otomatis termasuk; isi ini kalau ada
# domain lain, mis. preview deploy atau custom domain.
# WAJIB benar di produksi: origin yang tidak terdaftar diblokir browser.
CORS_ALLOWED_ORIGINS=

# ============================================
# KONFIGURASI SEED DATA
# ============================================
ADMIN_SEED_EMAIL=admin@mail.com
ADMIN_SEED_PASSWORD=Password123!
ADMIN_SEED_NAME=Admin Atlas

# ============================================
# KONFIGURASI UPLOAD FILE
# ============================================
UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE=10485760

# ============================================
# KONFIGURASI GROQ (analisis gizi AI)
# Dipakai endpoint POST /api/v1/ai/nutrition-analysis.
# Tanpa GROQ_API_KEY, endpoint mengembalikan 503 dan tombol
# "Analisis dengan AI" di halaman hasil recall akan menampilkan error.
# ============================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Analisis butuh waktu lebih lama dari request biasa.
GROQ_TIMEOUT_SECONDS=45
# Response berupa JSON dengan beberapa array (analisis, rekomendasi, aktivitas).
# Nilai terlalu kecil membuat JSON terpotong dan parsing gagal.
GROQ_MAX_TOKENS=2048
